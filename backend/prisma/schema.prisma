// Schema Prisma — ServiçoJá
// Para migrar para PostgreSQL, troque provider para "postgresql"

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// === USUÁRIO ===
model Usuario {
  id           String   @id @default(uuid())
  tipo         String   // "solicitante" | "prestador"
  nome         String
  email        String?  @unique // opcional — o login principal é o WhatsApp
  senhaHash    String
  whatsapp     String   @unique
  cidade       String
  cep          String?
  estado       String?
  rua          String?
  numero       String?
  complemento  String?
  foto         String?
  descricao    String?
  // Prestador-only (CSV no SQLite, array no Postgres)
  categorias   String?  // ex: "Elétrica,Pintura"
  bairros      String?  // ex: "Pinheiros,Vila Madalena"
  servicosConcluidos  Int    @default(0)
  statusVerificacao   String @default("PENDENTE") // PENDENTE | EM_REVISAO | APROVADO | REPROVADO
  notaMedia           Float  @default(0)
  totalAvaliacoes     Int    @default(0)
  criadoEm     DateTime @default(now())
  ativo        Boolean  @default(true)

  servicosComoSolicitante Servico[] @relation("ServicoSolicitante")
  servicosComoPrestador   Servico[] @relation("ServicoPrestador")
  acoes                   AcaoServico[]
  notificacoes            Notificacao[]
  conversasComoContratante Conversa[] @relation("ConversaContratante")
  conversasComoTrabalhador Conversa[] @relation("ConversaTrabalhador")
  mensagens               Mensagem[]
  avaliacoesFeitas        Avaliacao[] @relation("AvaliacaoAutor")
  avaliacoesRecebidas     Avaliacao[] @relation("AvaliacaoAlvo")
  interessesComoContratante InteresseProfissional[] @relation("InteresseContratante")
  interessesComoTrabalhador InteresseProfissional[] @relation("InteresseTrabalhador")
}

// === SERVIÇO ===
model Servico {
  id           String   @id @default(uuid())
  titulo       String
  descricao    String
  categoria    String
  fotos        String   // CSV de URLs
  cidade       String
  bairro       String
  lat          Float?   // geocodificado a partir de bairro+cidade ao postar
  lng          Float?
  estado       String   @default("ABERTO") // ABERTO | AGUARDANDO_APROVACAO | APROVADO | CONCLUIDO | CANCELADO
  // --- Trabalho externo (importado / postado pelo admin) ---
  origem        String  @default("PROPRIO") // PROPRIO | EXTERNO
  contatoExterno String? // WhatsApp do contratante original (só dígitos), quando origem=EXTERNO
  contatoTipo    String? // WHATSAPP | LINK — como o trabalhador fala com o contratante
  fonteNome      String? // ex: "empregos.com.br" ou "Admin"
  fonteUrl       String? // link da vaga/anúncio original (quando contatoTipo=LINK)
  criadoEm     DateTime @default(now())
  atualizadoEm DateTime @updatedAt

  solicitanteId String
  solicitante   Usuario @relation("ServicoSolicitante", fields: [solicitanteId], references: [id])

  prestadorAceitoId String?
  prestadorAceito   Usuario? @relation("ServicoPrestador", fields: [prestadorAceitoId], references: [id])

  acoes        AcaoServico[]
  notificacoes Notificacao[]
  conversas    Conversa[]
  avaliacoes   Avaliacao[]

  @@index([estado])
  @@index([solicitanteId])
  @@index([prestadorAceitoId])
}

// === AÇÃO SOBRE SERVIÇO (auditoria + bloqueio de re-exibição) ===
model AcaoServico {
  id          String   @id @default(uuid())
  servicoId   String
  prestadorId String
  acao           String   // ACEITOU | RECUSOU | APROVADO_PELO_CLIENTE | RECUSADO_PELO_CLIENTE
  motivo         String?
  valorProposto  Float?
  criadoEm       DateTime @default(now())

  servico   Servico @relation(fields: [servicoId], references: [id])
  prestador Usuario @relation(fields: [prestadorId], references: [id])

  @@index([prestadorId, servicoId])
}

// === NOTIFICAÇÃO ===
model Notificacao {
  id        String   @id @default(uuid())
  usuarioId String
  tipo      String
  titulo    String
  mensagem  String
  servicoId String?
  lida      Boolean  @default(false)
  criadoEm  DateTime @default(now())

  usuario Usuario  @relation(fields: [usuarioId], references: [id])
  servico Servico? @relation(fields: [servicoId], references: [id])

  @@index([usuarioId, lida])
}

// === CONVERSA (chat entre contratante e trabalhador interessado) ===
model Conversa {
  id            String   @id @default(uuid())
  servicoId     String?  // null = conversa direta (contratante curtiu o perfil, sem trabalho)
  assunto       String?  // texto exibido quando não há serviço (ex: "Interesse no seu perfil")
  contratanteId String
  trabalhadorId String
  status        String   @default("ABERTA") // ABERTA | FECHADA
  criadoEm      DateTime @default(now())
  atualizadoEm  DateTime @updatedAt

  servico     Servico? @relation(fields: [servicoId], references: [id])
  contratante Usuario @relation("ConversaContratante", fields: [contratanteId], references: [id])
  trabalhador Usuario @relation("ConversaTrabalhador", fields: [trabalhadorId], references: [id])
  mensagens   Mensagem[]

  @@unique([servicoId, trabalhadorId])
  @@index([contratanteId])
  @@index([trabalhadorId])
}

// === INTERESSE EM PROFISSIONAL (contratante curte/pula um prestador, sem trabalho) ===
model InteresseProfissional {
  id            String   @id @default(uuid())
  contratanteId String
  trabalhadorId String
  status        String   @default("ATIVO") // ATIVO (curtiu) | PULOU
  criadoEm      DateTime @default(now())

  contratante Usuario @relation("InteresseContratante", fields: [contratanteId], references: [id])
  trabalhador Usuario @relation("InteresseTrabalhador", fields: [trabalhadorId], references: [id])

  @@unique([contratanteId, trabalhadorId])
  @@index([trabalhadorId])
}

// === MENSAGEM ===
model Mensagem {
  id         String   @id @default(uuid())
  conversaId String
  autorId    String
  texto      String
  lida       Boolean  @default(false)
  criadoEm   DateTime @default(now())

  conversa Conversa @relation(fields: [conversaId], references: [id])
  autor    Usuario  @relation(fields: [autorId], references: [id])

  @@index([conversaId, criadoEm])
}

// === AVALIAÇÃO (1 por avaliador por serviço concluído) ===
model Avaliacao {
  id          String   @id @default(uuid())
  servicoId   String
  avaliadorId String
  avaliadoId  String
  nota        Int      // 1..5
  comentario  String?
  criadoEm    DateTime @default(now())

  servico   Servico @relation(fields: [servicoId], references: [id])
  avaliador Usuario @relation("AvaliacaoAutor", fields: [avaliadorId], references: [id])
  avaliado  Usuario @relation("AvaliacaoAlvo", fields: [avaliadoId], references: [id])

  @@unique([servicoId, avaliadorId])
  @@index([avaliadoId])
}
